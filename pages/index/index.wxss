/* pages/index/index.wxss */
page {
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .container {
    min-height: 100vh;
    padding-bottom: 100rpx;
  }
  
  .connect-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 60rpx 40rpx;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #007aff, #0051d5);
    color: white;
    border-radius: 60rpx;
    padding: 28rpx;
    font-size: 36rpx;
    width: 100%;
    margin-bottom: 30rpx;
    border: none;
    box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.3);
  }
  .btn-primary:active { transform: scale(0.98); opacity: 0.9; }
  
  .btn-secondary {
    background-color: #ff9500;
    color: white;
    border-radius: 60rpx;
    padding: 24rpx;
    font-size: 30rpx;
    width: 100%;
    border: none;
    margin-bottom: 40rpx;
  }
  .btn-secondary:active { transform: scale(0.98); opacity: 0.9; }
  
  .device-list { width: 100%; margin-top: 20rpx; }
  .list-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    color: #8e8e93;
    border-bottom: 1rpx solid #3a3a3c;
  }
  .refresh-btn { color: #007aff; padding: 10rpx; }
  .device-scroll { max-height: 600rpx; }
  .device-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #2c2c2e;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
  }
  .device-item:active { background-color: #3a3a3c; transform: scale(0.98); }
  .device-info { flex: 1; }
  .device-name {
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 8rpx;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10rpx;
  }
  .badge-camera {
    background-color: #007aff;
    color: white;
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
  }
  .device-id { font-size: 22rpx; color: #8e8e93; margin-bottom: 8rpx; word-break: break-all; }
  .device-signal { font-size: 24rpx; color: #8e8e93; display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
  .signal-bar {
    height: 8rpx;
    background: linear-gradient(90deg, #34c759, #ff9500, #ff3b30);
    border-radius: 4rpx;
    max-width: 200rpx;
  }
  .device-connect { background-color: #007aff; padding: 12rpx 20rpx; border-radius: 30rpx; }
  .connect-hint { font-size: 24rpx; color: white; }
  .scanning-tip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #2c2c2e;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
  }
  .scanning-text { font-size: 28rpx; color: #ff9500; }
  .btn-stop { background-color: #ff3b30; color: white; font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 40rpx; border: none; }
  
  .debug-info {
    margin-top: 40rpx;
    padding: 30rpx;
    background-color: #2c2c2e;
    border-radius: 24rpx;
    width: 100%;
  }
  .debug-title { font-size: 28rpx; color: #ff9500; font-weight: bold; display: block; margin-bottom: 16rpx; }
  .debug-text { font-size: 24rpx; color: #8e8e93; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
  
  .ble-tips {
    margin-top: 60rpx;
    padding: 30rpx;
    background-color: #2c2c2e;
    border-radius: 24rpx;
    width: 100%;
  }
  .tips-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; color: #007aff; }
  .tips-text { font-size: 26rpx; color: #8e8e93; display: block; margin-bottom: 12rpx; line-height: 1.5; }
  
  .debug-panel {
    width: 100%;
    margin-top: 30rpx;
    background-color: #1a1a1a;
    border-radius: 20rpx;
    border: 1rpx solid #3a3a3c;
  }
  .debug-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; border-bottom: 1rpx solid #3a3a3c; }
  .debug-clear { color: #ff9500; font-size: 24rpx; padding: 10rpx; }
  .debug-scroll { max-height: 400rpx; padding: 10rpx; }
  .debug-item { padding: 12rpx; border-bottom: 1rpx solid #2c2c2e; font-size: 22rpx; font-family: monospace; }
  .debug-time { color: #8e8e93; margin-right: 20rpx; }
  .debug-msg { color: #34c759; }
  .debug-data { display: block; color: #ff9500; margin-top: 8rpx; word-break: break-all; }
  
  .firmware-warning {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: #ff3b30;
    padding: 16rpx 20rpx;
    text-align: center;
    z-index: 98;
    font-size: 24rpx;
  }
  .warning-text { color: white; }
  
  .tab-bar {
    position: fixed;
    top: 88rpx;
    left: 0;
    right: 0;
    background-color: #2c2c2e;
    padding: 16rpx 20rpx;
    z-index: 99;
    white-space: nowrap;
    border-bottom: 1rpx solid #3a3a3c;
  }
  .tab-bar.with-warning { top: 128rpx; }
  .tab-item {
    display: inline-block;
    padding: 16rpx 32rpx;
    margin-right: 16rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    background-color: #3a3a3c;
    color: #8e8e93;
    transition: all 0.3s;
  }
  .tab-item.active { background: linear-gradient(135deg, #007aff, #0051d5); color: white; }
  
  .content { margin-top: 240rpx; padding: 20rpx; padding-bottom: 120rpx; }
  .card {
    background-color: #2c2c2e;
    border-radius: 32rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  }
  
  .record-section {
    position: relative;
    margin-bottom: 20rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20rpx;
    background: linear-gradient(135deg, #2c2c2e, #1c1c1e);
    border-radius: 32rpx;
  }
  .record-status-indicator {
    position: absolute;
    top: -10rpx;
    right: 20rpx;
    background-color: #ff3b30;
    padding: 8rpx 20rpx;
    border-radius: 30rpx;
    display: flex;
    align-items: center;
    gap: 10rpx;
    font-size: 24rpx;
    font-weight: bold;
    animation: blink 1s step-end infinite;
  }
  .recording-dot-large { width: 16rpx; height: 16rpx; background-color: white; border-radius: 8rpx; animation: blink 1s step-end infinite; }
  .record-hint { margin-top: 16rpx; text-align: center; }
  .hint-text { font-size: 24rpx; color: #8e8e93; }
  .hint-text-warning { font-size: 24rpx; color: #ff9500; }
  .record-btn {
    width: 280rpx;
    height: 280rpx;
    border-radius: 140rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #3a3a3c, #2c2c2e);
    border: 4rpx solid #ff3b30;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }
  .record-btn[disabled] { opacity: 0.5; border-color: #8e8e93; }
  .record-btn.recording {
    background: linear-gradient(135deg, #ff3b30, #cc2a1f);
    border-color: #ffffff;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,59,48,0.7); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 20rpx rgba(255,59,48,0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,59,48,0); }
  }
  .record-icon { font-size: 80rpx; margin-bottom: 16rpx; }
  .recording-animation { animation: blink 1s step-end infinite; }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
  .record-text { font-size: 32rpx; font-weight: bold; color: #ffffff; }
  .record-status { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 12rpx 24rpx; background-color: #2c2c2e; border-radius: 40rpx; }
  .recording-dot { width: 20rpx; height: 20rpx; background-color: #ff3b30; border-radius: 10rpx; animation: blink 1s step-end infinite; }
  .recording-time { font-family: monospace; font-size: 28rpx; color: #ff9500; margin-left: 16rpx; }
  .capture-btn {
    background: linear-gradient(135deg, #34c759, #28a745);
    color: white;
    border-radius: 60rpx;
    padding: 24rpx;
    font-size: 32rpx;
    margin-top: 20rpx;
    border: none;
  }
  .capture-btn:active { transform: scale(0.98); opacity: 0.9; }
  
  .param-row { display: flex; justify-content: space-between; align-items: center; margin: 20rpx 0 10rpx; }
  .form-label { font-size: 28rpx; color: #8e8e93; }
  .param-value { font-size: 32rpx; color: #007aff; font-weight: bold; }
  slider { margin: 20rpx 0 30rpx; }
  .form-select {
    background-color: #3a3a3c;
    color: white;
    border-radius: 16rpx;
    padding: 16rpx 24rpx;
    font-size: 28rpx;
    min-width: 180rpx;
    text-align: center;
  }
  .checkbox-row { display: flex; align-items: center; margin: 30rpx 0 10rpx; }
  .checkbox-row checkbox { margin-right: 20rpx; transform: scale(1.1); }
  .btn-group { display: flex; gap: 20rpx; margin-bottom: 30rpx; }
  .btn-outline-primary {
    background-color: transparent;
    border: 2rpx solid #007aff;
    color: #007aff;
    border-radius: 60rpx;
    padding: 20rpx;
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    transition: all 0.3s;
  }
  .btn-outline-primary:active { background-color: #007aff; color: white; transform: scale(0.98); }
  .resolution-group { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 20rpx 0; }
  .resolution-btn {
    background-color: #3a3a3c;
    color: #8e8e93;
    border-radius: 40rpx;
    padding: 16rpx 24rpx;
    font-size: 26rpx;
    border: none;
    transition: all 0.3s;
  }
  .resolution-btn:active { transform: scale(0.95); }
  .resolution-btn.active { background: linear-gradient(135deg, #007aff, #0051d5); color: white; }
  .sync-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: #ff9500;
    padding: 30rpx;
    text-align: center;
    z-index: 100;
    font-size: 28rpx;
  }
  .status-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #2c2c2e;
    padding: 20rpx 30rpx;
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
    color: #34c759;
    border-top: 1rpx solid #3a3a3c;
  }
  ::-webkit-scrollbar { width: 6rpx; height: 6rpx; }
  ::-webkit-scrollbar-track { background: #2c2c2e; border-radius: 3rpx; }
  ::-webkit-scrollbar-thumb { background: #007aff; border-radius: 3rpx; }
  ::-webkit-scrollbar-thumb:hover { background: #0051d5; }